{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MUD",
            "type": "shell",
            "command": "D:\\TOOLS\\MSYS2\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Iinclude",
                "main.cpp",
                "src/Server.cpp",
                "src/Client.cpp",
                "src/CommandsIO.cpp",
                "-o",
                "MUD.exe",
                "-lws2_32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the full project."
        }
    ]
}